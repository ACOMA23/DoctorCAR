@@ static void send_error(const char *code, int64_t ms)
+/* A07 (DEF-008): the host (Python receiver) requires all eight envelope fields; the firmware
+ * must reject an incomplete or mistyped HELLO/ACK before acting on it. NOT BUILT, NOT TESTED
+ * on a board: proposed patch only. */
+static bool is_nonneg_integer(const cJSON *item)
+{
+    return cJSON_IsNumber(item) && item->valuedouble >= 0 &&
+           item->valuedouble == (double)(int64_t)item->valuedouble;
+}
+
+static bool is_identifier(const cJSON *item)
+{
+    return cJSON_IsString(item) && item->valuestring &&
+           item->valuestring[0] != '\0' && strlen(item->valuestring) <= 128;
+}
+
+static bool envelope_is_valid(const cJSON *root)
+{
+    const cJSON *version = cJSON_GetObjectItemCaseSensitive(root, "protocol_version");
+    return cJSON_IsObject(root) &&
+           cJSON_IsNumber(version) && version->valuedouble == 1 &&
+           is_identifier(cJSON_GetObjectItemCaseSensitive(root, "type")) &&
+           is_identifier(cJSON_GetObjectItemCaseSensitive(root, "device_id")) &&
+           is_identifier(cJSON_GetObjectItemCaseSensitive(root, "session_id")) &&
+           is_nonneg_integer(cJSON_GetObjectItemCaseSensitive(root, "sequence_number")) &&
+           is_nonneg_integer(cJSON_GetObjectItemCaseSensitive(root, "timestamp_ms")) &&
+           is_identifier(cJSON_GetObjectItemCaseSensitive(root, "source")) &&
+           cJSON_IsObject(cJSON_GetObjectItemCaseSensitive(root, "payload"));
+}
